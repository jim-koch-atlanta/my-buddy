# Copy to .env and fill in. .env is gitignored; this example is committed as documentation.
POSTGRES_HOST=localhost
POSTGRES_DATABASE=mybuddy
POSTGRES_PORT=5432
PORT=3000

# Superuser name and password.
ADMIN_USER=mybuddy
ADMIN_PASSWORD=

# Appuser name and password.
APPUSER_USER=appuser
APPUSER_PASSWORD=

# OpenAI API key.
OPENAI_API_KEY=
